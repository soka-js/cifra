# Postgres (en Vercel lo crea la integracion de Neon). Usa la cadena "pooled".
DATABASE_URL=postgres://usuario:clave@host/db?sslmode=require

# URL publica del sitio, sin barra final. Se usa para enlaces embebidos, QR, OAuth y metadatos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Correo de contacto que aparece en la politica de datos y el pie de pagina.
NEXT_PUBLIC_CONTACT_EMAIL=contacto@cifra.co

# Correos (separados por coma) que pueden entrar a /admin. Es la UNICA forma de ser admin.
# Ademas el correo debe estar verificado: entra con Google, o usa "Olvide mi contrasena" y abre
# el enlace que llega a ese correo. Registrarse con el correo no basta.
ADMIN_EMAILS=

# Opcional: ID de medicion de Google Analytics 4 (G-XXXXXXX). Sin esto corre la analitica propia.
NEXT_PUBLIC_GA_ID=

# Opcional: canales REALES donde los negocios pagan la comision. Se muestran tal cual en la cuenta
# del negocio. Si se dejan vacios no se muestra ningun canal (nunca un numero de relleno).
CIFRA_BREB_KEY=
CIFRA_NEQUI_NUMBER=

# Opcional: Pasarela Wompi para pago en linea de comisiones (si no estan, queda activo Bre-B/Nequi con comprobante).
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Opcional: Correo transaccional (recuperar contrasena, avisos, informe mensual al tendero).
# Opcion A: Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="CIFRA <avisos@cifra.co>"
# Opcion B: SMTP estandar o Gmail con contrasena de aplicacion (smtp://usuario:clave@smtp.gmail.com:587)
SMTP_URL=

# Opcional: "Continuar con Google" (Google Cloud Console -> OAuth 2.0 Client).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: Gemini API para clasificar comercios desconocidos y consultas libres.
GEMINI_API_KEY=

# Opcional: Notificaciones Web Push (generar con `npx web-push generate-vapid-keys`).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@cifra.co

# Secreto para proteger el cron diario (/api/cron/daily). En Vercel Cron se envia como Bearer token.
CRON_SECRET=
