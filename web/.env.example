# Postgres (en Vercel lo crea la integracion de Neon). Usa la cadena "pooled".
DATABASE_URL=postgres://usuario:clave@host/db?sslmode=require

# URL publica del sitio, sin barra final. Se usa para enlaces embebidos y metadatos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Correo de contacto que aparece en la politica de datos y el pie de pagina.
NEXT_PUBLIC_CONTACT_EMAIL=

# Opcional: ID de medicion de Google Analytics 4 (G-XXXXXXX). Sin esto solo corre la analitica propia.
NEXT_PUBLIC_GA_ID=

# Correos (separados por coma) que pueden ver /admin con las metricas de la landing.
ADMIN_EMAILS=
